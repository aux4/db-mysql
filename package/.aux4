{
  "scope": "aux4",
  "name": "db-mysql",
  "version": "2.0.1",
  "description": "mysql database tools",
  "tags": [
    "db",
    "database",
    "mysql"
  ],
  "dependencies": [
    "aux4/db"
  ],
  "profiles": [
    {
      "name": "db",
      "commands": [
        {
          "name": "mysql",
          "execute": [
            "profile:db:mysql"
          ],
          "help": {
            "text": "mysql database tools"
          }
        }
      ]
    },
    {
      "name": "db:mysql",
      "commands": [
        {
          "name": "execute",
          "execute": [
            "stdin:aux4 db driver prepare execute params(query, file, inputStream, tx, ignore) --params value(*) | node ${packageDir}/lib/aux4-db-mysql.js values(host, port, database, user, password)"
          ],
          "help": {
            "text": "Execute a query on the mysql database",
            "variables": [
              {
                "name": "host",
                "text": "Database host",
                "default": "localhost"
              },
              {
                "name": "port",
                "text": "Database port",
                "default": "3306"
              },
              {
                "name": "database",
                "text": "Database name",
                "default": "mysql"
              },
              {
                "name": "user",
                "text": "Database user",
                "default": "root"
              },
              {
                "name": "password",
                "text": "Database password"
              },
              {
                "name": "query",
                "text": "SQL query to execute",
                "default": "",
                "arg": true
              },
              {
                "name": "file",
                "text": "SQL file to execute",
                "default": ""
              },
              {
                "name": "inputStream",
                "text": "Read JSON input from stdin",
                "default": "false"
              },
              {
                "name": "tx",
                "text": "Use transaction for batch operations",
                "default": "false"
              },
              {
                "name": "ignore",
                "text": "Ignore errors and continue processing",
                "default": "false"
              }
            ]
          }
        },
        {
          "name": "stream",
          "execute": [
            "stdin:aux4 db driver prepare stream params(query, file, inputStream, tx, ignore) --params value(*) | node ${packageDir}/lib/aux4-db-mysql.js values(host, port, database, user, password)"
          ],
          "help": {
            "text": "Execute a query on the mysql database and stream results",
            "variables": [
              {
                "name": "host",
                "text": "Database host",
                "default": "localhost"
              },
              {
                "name": "port",
                "text": "Database port",
                "default": "3306"
              },
              {
                "name": "database",
                "text": "Database name",
                "default": "mysql"
              },
              {
                "name": "user",
                "text": "Database user",
                "default": "root"
              },
              {
                "name": "password",
                "text": "Database password"
              },
              {
                "name": "query",
                "text": "SQL query to execute",
                "default": ""
              },
              {
                "name": "file",
                "text": "SQL file to execute",
                "default": ""
              },
              {
                "name": "inputStream",
                "text": "Read JSON input from stdin",
                "default": "false"
              },
              {
                "name": "tx",
                "text": "Use transaction for batch operations",
                "default": "false"
              },
              {
                "name": "ignore",
                "text": "Ignore errors and continue processing",
                "default": "false"
              }
            ]
          }
        },
        {
          "name": "describe",
          "execute": [
            "stdin:aux4 db driver prepare execute --query \"SELECT COLUMN_NAME AS \\\"name\\\", DATA_TYPE AS \\\"type\\\", CASE WHEN IS_NULLABLE='YES' THEN true ELSE false END AS \\\"nullable\\\", COLUMN_DEFAULT AS \\\"default\\\", COLUMN_KEY AS \\\"key\\\", EXTRA AS \\\"extra\\\", COLUMN_COMMENT AS \\\"comment\\\" FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME=:table ORDER BY ORDINAL_POSITION\" --params value(*) | node ${packageDir}/lib/aux4-db-mysql.js values(host, port, database, user, password) | node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const t=d.trim();const o=t?JSON.parse(t).map(r=>{('nullable' in r)?(r.nullable=r.nullable?true:false):0;return Object.keys(r).reduce((a,k)=>{const v=r[k];[null,''].indexOf(v)<0?a[k]=v:0;return a},{});}):'';o?console.log(JSON.stringify(o)):0;});\""
          ],
          "help": {
            "text": "Describe the columns of a table",
            "variables": [
              {
                "name": "host",
                "text": "Database host",
                "default": "localhost"
              },
              {
                "name": "port",
                "text": "Database port",
                "default": "3306"
              },
              {
                "name": "database",
                "text": "Database name",
                "default": "mysql"
              },
              {
                "name": "user",
                "text": "Database user",
                "default": "root"
              },
              {
                "name": "password",
                "text": "Database password"
              },
              {
                "name": "table",
                "text": "Table name to describe"
              }
            ]
          }
        },
        {
          "name": "desc",
          "execute": [
            "aux4 db mysql describe params(host, port, database, user, password, table)"
          ],
          "help": {
            "text": "Describe the columns of a table (alias of describe)",
            "variables": [
              {
                "name": "host",
                "text": "Database host",
                "default": "localhost"
              },
              {
                "name": "port",
                "text": "Database port",
                "default": "3306"
              },
              {
                "name": "database",
                "text": "Database name",
                "default": "mysql"
              },
              {
                "name": "user",
                "text": "Database user",
                "default": "root"
              },
              {
                "name": "password",
                "text": "Database password"
              },
              {
                "name": "table",
                "text": "Table name to describe"
              }
            ]
          }
        },
        {
          "name": "list",
          "execute": [
            "profile:db:mysql:list"
          ],
          "help": {
            "text": "List database objects (tables, ...)"
          }
        }
      ]
    },
    {
      "name": "db:mysql:list",
      "commands": [
        {
          "name": "tables",
          "execute": [
            "stdin:aux4 db driver prepare execute --query \"SELECT TABLE_NAME AS \\\"name\\\", TABLE_SCHEMA AS \\\"database\\\", TABLE_COMMENT AS \\\"comment\\\" FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_TYPE='BASE TABLE' ORDER BY TABLE_NAME\" --params value(*) | node ${packageDir}/lib/aux4-db-mysql.js values(host, port, database, user, password) | node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const t=d.trim();const o=t?JSON.parse(t).map(r=>{('nullable' in r)?(r.nullable=r.nullable?true:false):0;return Object.keys(r).reduce((a,k)=>{const v=r[k];[null,''].indexOf(v)<0?a[k]=v:0;return a},{});}):'';o?console.log(JSON.stringify(o)):0;});\""
          ],
          "help": {
            "text": "List the base tables in the database",
            "variables": [
              {
                "name": "host",
                "text": "Database host",
                "default": "localhost"
              },
              {
                "name": "port",
                "text": "Database port",
                "default": "3306"
              },
              {
                "name": "database",
                "text": "Database name",
                "default": "mysql"
              },
              {
                "name": "user",
                "text": "Database user",
                "default": "root"
              },
              {
                "name": "password",
                "text": "Database password"
              }
            ]
          }
        },
        {
          "name": "databases",
          "execute": [
            "stdin:aux4 db driver prepare execute --query \"SELECT SCHEMA_NAME AS \\\"name\\\" FROM INFORMATION_SCHEMA.SCHEMATA ORDER BY SCHEMA_NAME\" --params value(*) | node ${packageDir}/lib/aux4-db-mysql.js values(host, port, database, user, password) | node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const t=d.trim();const o=t?JSON.parse(t).map(r=>{('nullable' in r)?(r.nullable=r.nullable?true:false):0;return Object.keys(r).reduce((a,k)=>{const v=r[k];[null,''].indexOf(v)<0?a[k]=v:0;return a},{});}):'';o?console.log(JSON.stringify(o)):0;});\""
          ],
          "help": {
            "text": "List the databases (schemas) on the server",
            "variables": [
              {
                "name": "host",
                "text": "Database host",
                "default": "localhost"
              },
              {
                "name": "port",
                "text": "Database port",
                "default": "3306"
              },
              {
                "name": "database",
                "text": "Database name",
                "default": "mysql"
              },
              {
                "name": "user",
                "text": "Database user",
                "default": "root"
              },
              {
                "name": "password",
                "text": "Database password"
              }
            ]
          }
        }
      ]
    }
  ]
}
